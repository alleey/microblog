/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "auth-oidc": [
        "projects/auth-oidc/src/public_api"
      ],
      "blog": [
        "projects/blog/src/public_api"
      ],
      "bookmarks": [
        "projects/bookmarks/src/public_api"
      ],
      "followers": [
        "projects/followers/src/public_api"
      ],
      "resources": [
        "projects/resources/src/public_api"
      ],
      "stats": [
        "projects/stats/src/public_api"
      ],
      "userprofile": [
        "projects/userprofile/src/public_api"
      ],
      "utils": [
        "projects/utils/src/public_api"
      ]
    },
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "es2015",
    "module": "es2020",
    "lib": [
      "es2018",
      "dom"
    ]
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
